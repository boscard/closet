#!/usr/bin/env bash

# KVM Debian VM Creation Script
# Creates Debian 12 virtual machines with cloud-init configuration
# Author: Generated for KVM/libvirt environment

set -euo pipefail

# Script configuration
SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CACHE_DIR="${SCRIPT_DIR}/cache"
TEMPLATES_DIR="${SCRIPT_DIR}/templates"

# Default values
DEFAULT_RAM=2048
DEFAULT_CPUS=2
DEFAULT_STORAGE_POOL="default"
DEFAULT_STORAGE_PATH=""
DEFAULT_DEBIAN_VERSION=12
DEFAULT_DNS="8.8.8.8"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Global variables
VM_NAME=""
DISK_SIZE=""
LIBVIRT_NETWORK=""
RAM_SIZE=$DEFAULT_RAM
CPU_COUNT=$DEFAULT_CPUS
USERNAME="$(whoami)"
SSH_KEYS_SOURCE="local"
SSH_KEYS_GITHUB=""
SSH_KEYS_GITLAB=""
SSH_KEY_FILE=""
STATIC_IP=""
GATEWAY=""
DNS_SERVER="$DEFAULT_DNS"
STORAGE_POOL="$DEFAULT_STORAGE_POOL"
STORAGE_PATH="$DEFAULT_STORAGE_PATH"
DEBIAN_VERSION="$DEFAULT_DEBIAN_VERSION"
LIBVIRT_URI=""
AUTOSTART=false
CONSOLE_ACCESS=false
CUSTOM_USER_DATA=""
CHECK_ONLY=false

# Privilege escalation variables
IS_ROOT=false
SUDO_AVAILABLE=false
SUDO_CMD=""

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Usage function
usage() {
    cat << EOF
Usage: $SCRIPT_NAME <vm-name> <disk-size> <libvirt-network> [OPTIONS]

Required Parameters:
  vm-name              Name of the virtual machine
  disk-size            Size of the VM disk (e.g., 20G, 1024M)
  libvirt-network      Libvirt network name (e.g., default, host-bridge)

Optional Parameters:
  --ram <size>         RAM size in MB (default: $DEFAULT_RAM)
  --cpus <count>       Number of CPUs (default: $DEFAULT_CPUS)
  --user <username>    VM username (default: current user)
  --ssh-keys-github <user>    Pull SSH keys from GitHub
  --ssh-keys-gitlab <user>    Pull SSH keys from GitLab
  --ssh-key-file <path>       Use custom SSH key file
  --static-ip <ip/cidr>       Static IP configuration (e.g., 192.168.1.100/24)
  --gateway <ip>              Gateway IP (required with static IP)
  --dns <ip>                  DNS server (default: $DEFAULT_DNS)
  --storage-pool <pool>       Libvirt storage pool (default: $DEFAULT_STORAGE_POOL)
  --storage-path <path>       VM storage directory (overrides storage pool)
  --debian-version <ver>      Debian version (default: $DEFAULT_DEBIAN_VERSION)
  --libvirt-uri <uri>         Libvirt connection URI (default: local system)
  --autostart                 Enable VM autostart
  --console                   Setup serial console access
  --user-data <file>          Custom cloud-init user-data file
  --check-only                Only check prerequisites and exit
  --help                      Show this help message

Examples:
  $SCRIPT_NAME myvm 20G default
  $SCRIPT_NAME webserver 50G host-bridge --ram 4096 --cpus 4 --ssh-keys-github myuser
  $SCRIPT_NAME db 100G default --static-ip 192.168.1.100/24 --gateway 192.168.1.1
  $SCRIPT_NAME remote 30G default --libvirt-uri qemu+ssh://user@host/system
EOF
}

# Distribution detection
detect_distribution() {
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release
        echo "$ID"
    elif [[ -f /etc/redhat-release ]]; then
        echo "fedora"
    elif [[ -f /etc/debian_version ]]; then
        echo "debian"
    else
        echo "unknown"
    fi
}

# Get package installation command based on distribution
get_install_command() {
    local distro="$1"
    case "$distro" in
        "debian"|"ubuntu")
            echo "sudo apt update && sudo apt install"
            ;;
        "fedora"|"rhel"|"centos"|"rocky"|"almalinux")
            echo "sudo dnf install"
            ;;
        *)
            echo "# Unknown distribution - install manually:"
            ;;
    esac
}

# Get package names based on distribution
get_package_name() {
    local cmd="$1"
    local distro="$2"
    
    case "$cmd" in
        "virsh")
            case "$distro" in
                "debian"|"ubuntu") echo "libvirt-clients" ;;
                "fedora"|"rhel"|"centos"|"rocky"|"almalinux") echo "libvirt-client" ;;
                *) echo "libvirt-clients" ;;
            esac
            ;;
        "virt-install")
            case "$distro" in
                "debian"|"ubuntu") echo "virtinst" ;;
                "fedora"|"rhel"|"centos"|"rocky"|"almalinux") echo "virt-install" ;;
                *) echo "virtinst" ;;
            esac
            ;;
        "qemu-img")
            case "$distro" in
                "debian"|"ubuntu") echo "qemu-utils" ;;
                "fedora"|"rhel"|"centos"|"rocky"|"almalinux") echo "qemu-img" ;;
                *) echo "qemu-utils" ;;
            esac
            ;;
        "genisoimage")
            case "$distro" in
                "debian"|"ubuntu") echo "genisoimage" ;;
                "fedora"|"rhel"|"centos"|"rocky"|"almalinux") echo "genisoimage" ;;
                *) echo "genisoimage" ;;
            esac
            ;;
        "curl")
            echo "curl"
            ;;
        "ip")
            case "$distro" in
                "debian"|"ubuntu") echo "iproute2" ;;
                "fedora"|"rhel"|"centos"|"rocky"|"almalinux") echo "iproute" ;;
                *) echo "iproute2" ;;
            esac
            ;;
        *)
            echo "$cmd"
            ;;
    esac
}

# Privilege detection and management functions
detect_privileges() {
    log_info "Detecting privilege requirements..."
    
    # Check if running as root
    if [[ $EUID -eq 0 ]]; then
        IS_ROOT=true
        SUDO_CMD=""
        log_info "Running as root user"
        return 0
    fi
    
    # Check if sudo is available
    if command -v sudo >/dev/null 2>&1; then
        # Test if sudo works without password prompt for a simple command
        if sudo -n true 2>/dev/null; then
            SUDO_AVAILABLE=true
            SUDO_CMD="sudo"
            log_info "Sudo available without password prompt"
        elif sudo -v 2>/dev/null; then
            SUDO_AVAILABLE=true
            SUDO_CMD="sudo"
            log_info "Sudo available (may require password)"
        else
            SUDO_AVAILABLE=false
            SUDO_CMD=""
            log_warning "Sudo available but authentication failed"
        fi
    else
        SUDO_AVAILABLE=false
        SUDO_CMD=""
        log_warning "Sudo not available"
    fi
    
    # Display privilege status
    if [[ "$IS_ROOT" == true ]]; then
        log_success "Privilege escalation: Running as root"
    elif [[ "$SUDO_AVAILABLE" == true ]]; then
        log_success "Privilege escalation: Using sudo"
    else
        log_warning "Privilege escalation: Limited - some operations may fail"
    fi
}

# Execute command with appropriate privileges
run_privileged() {
    local cmd="$*"
    
    if [[ "$IS_ROOT" == true ]]; then
        # Running as root, execute directly
        eval "$cmd"
    elif [[ "$SUDO_AVAILABLE" == true ]]; then
        # Use sudo
        eval "$SUDO_CMD $cmd"
    else
        # No privilege escalation available, try anyway
        log_warning "Attempting command without privileges: $cmd"
        eval "$cmd"
    fi
}

# Check if we need privileges for a specific operation
needs_privileges() {
    local operation="$1"
    local target_path="$2"
    
    case "$operation" in
        "write_storage")
            # Check if we can write to storage location
            if [[ -w "$target_path" ]]; then
                return 1  # No privileges needed
            else
                return 0  # Privileges needed
            fi
            ;;
        "chown")
            # chown always needs privileges unless running as root
            if [[ "$IS_ROOT" == true ]]; then
                return 1  # No additional privileges needed
            else
                return 0  # Privileges needed
            fi
            ;;
        *)
            return 0  # Default: assume privileges needed
            ;;
    esac
}

# Libvirt URI helper function
get_virsh_args() {
    if [[ -n "$LIBVIRT_URI" ]]; then
        echo "--connect $LIBVIRT_URI"
    fi
}

get_virt_install_args() {
    if [[ -n "$LIBVIRT_URI" ]]; then
        echo "--connect $LIBVIRT_URI"
    fi
}

# Prerequisites checking functions
check_command() {
    local cmd="$1"
    local distro="$2"
    local package
    package=$(get_package_name "$cmd" "$distro")
    local install_cmd
    install_cmd=$(get_install_command "$distro")
    
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log_error "Command '$cmd' not found. Install with: $install_cmd $package"
        return 1
    fi
    return 0
}

check_service() {
    local service="$1"
    
    if ! systemctl is-active "$service" >/dev/null 2>&1; then
        log_error "Service '$service' is not running. Start with: systemctl start $service"
        return 1
    fi
    return 0
}

check_libvirt_services() {
    # Check if libvirt is working by testing virsh connectivity
    local virsh_args
    virsh_args=$(get_virsh_args)
    if virsh $virsh_args list >/dev/null 2>&1; then
        return 0
    fi
    
    # If virsh fails, check for libvirt services
    # Modern libvirt uses modular daemons, older versions use monolithic libvirtd
    local libvirt_services=("libvirtd" "virtqemud" "virtnetworkd")
    local service_found=false
    
    for service in "${libvirt_services[@]}"; do
        if systemctl is-active "$service" >/dev/null 2>&1; then
            service_found=true
            break
        fi
    done
    
    if [[ "$service_found" == false ]]; then
        log_error "No libvirt services are running. Try starting:"
        log_error "  Modern libvirt: systemctl start virtqemud virtnetworkd"
        log_error "  Legacy libvirt: systemctl start libvirtd"
        return 1
    fi
    
    # If services are running but virsh still fails, it's a permission issue
    log_error "Libvirt services are running but virsh connection failed"
    log_error "Check user permissions: sudo usermod -a -G libvirt $USER"
    return 1
}

check_prerequisites() {
    log_info "Checking system prerequisites..."
    
    local errors=0
    local distro
    distro=$(detect_distribution)
    local install_cmd
    install_cmd=$(get_install_command "$distro")
    
    log_info "Detected distribution: $distro"
    
    # Required commands
    local required_commands=(
        "virsh"
        "virt-install"
        "qemu-img"
        "curl"
        "ip"
    )
    
    # Check for genisoimage or mkisofs
    if ! command -v genisoimage >/dev/null 2>&1 && ! command -v mkisofs >/dev/null 2>&1; then
        local genisoimage_pkg
        genisoimage_pkg=$(get_package_name "genisoimage" "$distro")
        log_error "Neither 'genisoimage' nor 'mkisofs' found. Install with: $install_cmd $genisoimage_pkg"
        ((errors++))
    fi
    
    for cmd in "${required_commands[@]}"; do
        if ! check_command "$cmd" "$distro"; then
            ((errors++))
        fi
    done
    
    # Check libvirt services and connectivity
    if ! check_libvirt_services; then
        ((errors++))
    fi
    
    # Check user permissions
    if ! groups | grep -q libvirt && [[ $EUID -ne 0 ]]; then
        log_error "User must be in 'libvirt' group or run as root. Add with: sudo usermod -a -G libvirt $USER"
        ((errors++))
    fi
    
    # Check KVM support
    if [[ ! -e /dev/kvm ]]; then
        log_error "KVM not available. Check BIOS virtualization settings"
        ((errors++))
    fi
    
    if [[ $errors -gt 0 ]]; then
        log_error "Found $errors prerequisite issues. Please resolve them before continuing."
        return 1
    fi
    
    log_success "All prerequisites satisfied"
    return 0
}

# Parameter validation functions
validate_disk_size() {
    if [[ ! "$DISK_SIZE" =~ ^[0-9]+[GMK]?$ ]]; then
        log_error "Invalid disk size format: $DISK_SIZE (use format like 20G, 1024M)"
        return 1
    fi
}

validate_libvirt_network() {
    local virsh_args
    virsh_args=$(get_virsh_args)
    
    if ! virsh $virsh_args net-list --all | grep -q "\\b$LIBVIRT_NETWORK\\b"; then
        log_error "Libvirt network '$LIBVIRT_NETWORK' not found"
        log_info "Available networks:"
        virsh $virsh_args net-list --all | tail -n +3 | awk '{print "  " $1}' || true
        return 1
    fi
    
    # Check if network is active
    if ! virsh $virsh_args net-list | grep -q "\\b$LIBVIRT_NETWORK\\b"; then
        log_warning "Libvirt network '$LIBVIRT_NETWORK' is not active"
        if [[ -n "$LIBVIRT_URI" ]]; then
            log_info "Start it with: virsh --connect $LIBVIRT_URI net-start $LIBVIRT_NETWORK"
        else
            log_info "Start it with: virsh net-start $LIBVIRT_NETWORK"
        fi
    fi
}

validate_vm_name() {
    local virsh_args
    virsh_args=$(get_virsh_args)
    
    if virsh $virsh_args list --all | grep -q "\\b$VM_NAME\\b"; then
        log_error "VM '$VM_NAME' already exists"
        return 1
    fi
}

validate_static_ip() {
    if [[ -n "$STATIC_IP" ]]; then
        if [[ -z "$GATEWAY" ]]; then
            log_error "Gateway is required when using static IP"
            return 1
        fi
        
        # Basic IP format validation
        if [[ ! "$STATIC_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]]; then
            log_error "Invalid static IP format: $STATIC_IP (use format like 192.168.1.100/24)"
            return 1
        fi
    fi
}

validate_storage_pool() {
    local virsh_args
    virsh_args=$(get_virsh_args)
    
    if ! virsh $virsh_args pool-list --all | grep -q "\\b$STORAGE_POOL\\b"; then
        log_error "Libvirt storage pool '$STORAGE_POOL' not found"
        log_info "Available storage pools:"
        virsh $virsh_args pool-list --all | tail -n +3 | awk '{print "  " $1}' || true
        return 1
    fi
    
    # Check if pool is active
    if ! virsh $virsh_args pool-list | grep -q "\\b$STORAGE_POOL\\b"; then
        log_warning "Libvirt storage pool '$STORAGE_POOL' is not active"
        if [[ -n "$LIBVIRT_URI" ]]; then
            log_info "Start it with: virsh --connect $LIBVIRT_URI pool-start $STORAGE_POOL"
        else
            log_info "Start it with: virsh pool-start $STORAGE_POOL"
        fi
        return 1
    fi
}

validate_storage_path() {
    if [[ ! -d "$STORAGE_PATH" ]]; then
        log_error "Storage path does not exist: $STORAGE_PATH"
        return 1
    fi
    
    # Check write permissions, considering privilege escalation
    if [[ ! -w "$STORAGE_PATH" ]]; then
        if [[ "$IS_ROOT" == true ]] || [[ "$SUDO_AVAILABLE" == true ]]; then
            log_info "Storage path requires elevated privileges (will use $([[ "$IS_ROOT" == true ]] && echo "root" || echo "sudo"))"
        else
            log_error "No write permission to storage path: $STORAGE_PATH"
            return 1
        fi
    fi
}

get_storage_location() {
    if [[ -n "$STORAGE_PATH" ]]; then
        # Use explicit storage path
        echo "$STORAGE_PATH"
    else
        # Get path from storage pool
        local virsh_args
        virsh_args=$(get_virsh_args)
        local pool_path
        pool_path=$(virsh $virsh_args pool-dumpxml "$STORAGE_POOL" | grep -o '<path>[^<]*</path>' | sed 's/<[^>]*>//g')
        
        if [[ -z "$pool_path" ]]; then
            log_error "Could not determine path for storage pool '$STORAGE_POOL'"
            return 1
        fi
        
        echo "$pool_path"
    fi
}

# SSH key handling functions
get_ssh_keys() {
    local keys=""
    
    case "$SSH_KEYS_SOURCE" in
        "local")
            keys=$(get_local_ssh_keys)
            ;;
        "github")
            keys=$(get_github_ssh_keys "$SSH_KEYS_GITHUB")
            ;;
        "gitlab")
            keys=$(get_gitlab_ssh_keys "$SSH_KEYS_GITLAB")
            ;;
        "file")
            keys=$(get_file_ssh_keys "$SSH_KEY_FILE")
            ;;
    esac
    
    if [[ -z "$keys" ]]; then
        log_error "No SSH keys found from source: $SSH_KEYS_SOURCE"
        return 1
    fi
    
    echo "$keys"
}

get_local_ssh_keys() {
    local ssh_dir="$HOME/.ssh"
    local key_files=("id_rsa.pub" "id_ed25519.pub" "id_ecdsa.pub")
    
    for key_file in "${key_files[@]}"; do
        if [[ -f "$ssh_dir/$key_file" ]]; then
            cat "$ssh_dir/$key_file"
            return 0
        fi
    done
    
    return 1
}

get_github_ssh_keys() {
    local username="$1"
    log_info "Fetching SSH keys from GitHub for user: $username"
    
    local keys
    keys=$(curl -sf "https://github.com/$username.keys" 2>/dev/null)
    
    if [[ -z "$keys" ]]; then
        log_error "No SSH keys found for GitHub user: $username"
        return 1
    fi
    
    echo "$keys"
}

get_gitlab_ssh_keys() {
    local username="$1"
    log_info "Fetching SSH keys from GitLab for user: $username"
    
    local keys
    keys=$(curl -sf "https://gitlab.com/$username.keys" 2>/dev/null)
    
    if [[ -z "$keys" ]]; then
        log_error "No SSH keys found for GitLab user: $username"
        return 1
    fi
    
    echo "$keys"
}

get_file_ssh_keys() {
    local key_file="$1"
    
    if [[ ! -f "$key_file" ]]; then
        log_error "SSH key file not found: $key_file"
        return 1
    fi
    
    cat "$key_file"
}

# Cloud-init configuration functions
create_cloud_init_files() {
    local temp_dir="$1"
    local ssh_keys="$2"
    
    log_info "Creating cloud-init configuration files..."
    
    # Create user-data
    create_user_data "$temp_dir/user-data" "$ssh_keys"
    
    # Create meta-data
    create_meta_data "$temp_dir/meta-data"
    
    # Create network-config
    create_network_config "$temp_dir/network-config"
}

create_user_data() {
    local file="$1"
    local ssh_keys="$2"
    
    if [[ -n "$CUSTOM_USER_DATA" && -f "$CUSTOM_USER_DATA" ]]; then
        log_info "Using custom user-data file: $CUSTOM_USER_DATA"
        cp "$CUSTOM_USER_DATA" "$file"
        return
    fi
    
    # Format SSH keys for YAML
    local formatted_keys=""
    while IFS= read -r key; do
        [[ -n "$key" ]] && formatted_keys+="      - $key"$'\n'
    done <<< "$ssh_keys"
    
    cat > "$file" << EOF
#cloud-config
users:
  - name: $USERNAME
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
$formatted_keys
    lock_passwd: true

ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: true

packages:
  - curl
  - wget
  - vim
  - htop
  - git
  - ufw

runcmd:
  - systemctl enable ssh
  - ufw allow ssh
  - ufw --force enable
  - echo "VM setup completed" > /var/log/cloud-init-complete

final_message: "Debian VM is ready for use!"
EOF
}

create_meta_data() {
    local file="$1"
    
    cat > "$file" << EOF
instance-id: $VM_NAME
local-hostname: $VM_NAME
EOF
}

create_network_config() {
    local file="$1"
    
    if [[ -n "$STATIC_IP" ]]; then
        # Static IP configuration
        local ip="${STATIC_IP%/*}"
        local cidr="${STATIC_IP#*/}"
        
        cat > "$file" << EOF
version: 2
ethernets:
  enp1s0:
    addresses:
      - $STATIC_IP
    gateway4: $GATEWAY
    nameservers:
      addresses:
        - $DNS_SERVER
EOF
    else
        # DHCP configuration
        cat > "$file" << EOF
version: 2
ethernets:
  enp1s0:
    dhcp4: true
EOF
    fi
}

# VM creation functions
download_debian_image() {
    local image_url="https://cloud.debian.org/images/cloud/bookworm/latest/debian-${DEBIAN_VERSION}-generic-amd64.qcow2"
    local image_file="$CACHE_DIR/debian-${DEBIAN_VERSION}-generic-amd64.qcow2"
    
    if [[ "$DEBIAN_VERSION" == "11" ]]; then
        image_url="https://cloud.debian.org/images/cloud/bullseye/latest/debian-11-generic-amd64.qcow2"
    fi
    
    mkdir -p "$CACHE_DIR"
    
    if [[ -f "$image_file" ]]; then
        log_info "Using cached Debian $DEBIAN_VERSION image" >&2
    else
        log_info "Downloading Debian $DEBIAN_VERSION cloud image..." >&2
        if ! curl -L -o "$image_file" "$image_url"; then
            log_error "Failed to download Debian image" >&2
            return 1
        fi
        log_success "Downloaded Debian $DEBIAN_VERSION image" >&2
    fi
    
    echo "$image_file"
}

create_vm_disk() {
    local base_image="$1"
    local vm_disk="$STORAGE_PATH/${VM_NAME}.qcow2"
    local virsh_args
    virsh_args=$(get_virsh_args)
    
    log_info "Creating VM disk: $vm_disk"
    
    # Check if we're using storage pools or direct paths
    if [[ -n "$STORAGE_PATH" && "$STORAGE_PATH" != "/var/lib/libvirt/images" ]]; then
        # Using explicit storage path - create disk manually
        local storage_base_image="$STORAGE_PATH/$(basename "$base_image")"
        
        if [[ ! -f "$storage_base_image" ]]; then
            log_info "Copying base image to storage location for libvirt access..."
            if ! run_privileged cp "$base_image" "$storage_base_image"; then
                log_error "Failed to copy base image to storage location"
                return 1
            fi
            # Set appropriate permissions for libvirt
            run_privileged chmod 644 "$storage_base_image"
            if needs_privileges "chown" "$storage_base_image"; then
                run_privileged chown libvirt-qemu:libvirt-qemu "$storage_base_image" 2>/dev/null || true
            fi
        fi
        
        # Create disk from base image in storage location
        if ! run_privileged qemu-img create -f qcow2 -F qcow2 -b "$storage_base_image" "$vm_disk" "$DISK_SIZE"; then
            log_error "Failed to create VM disk"
            return 1
        fi
        
        # Set proper ownership for the VM disk
        if needs_privileges "chown" "$vm_disk"; then
            run_privileged chown libvirt-qemu:libvirt-qemu "$vm_disk" 2>/dev/null || true
        fi
    else
        # Using storage pool - create volume using libvirt
        local base_volume_name="$(basename "$base_image")"
        local vm_volume_name="${VM_NAME}.qcow2"
        
        # First, ensure base image exists as a volume in the pool
        if ! virsh $virsh_args vol-list "$STORAGE_POOL" | grep -q "\\b$base_volume_name\\b"; then
            log_info "Creating base image volume in storage pool..."
            if ! virsh $virsh_args vol-create-as "$STORAGE_POOL" "$base_volume_name" 0 --format qcow2; then
                log_error "Failed to create base volume"
                return 1
            fi
            # Upload the base image to the volume
            if ! virsh $virsh_args vol-upload --pool "$STORAGE_POOL" "$base_volume_name" "$base_image"; then
                log_error "Failed to upload base image to volume"
                return 1
            fi
        fi
        
        # Create VM volume with backing volume
        log_info "Creating VM volume with backing image..."
        if ! virsh $virsh_args vol-create-as "$STORAGE_POOL" "$vm_volume_name" "$DISK_SIZE" --format qcow2 --backing-vol "$base_volume_name" --backing-vol-format qcow2; then
            log_error "Failed to create VM volume"
            return 1
        fi
    fi
    
    echo "$vm_disk"
}

create_cloud_init_iso() {
    local temp_dir="$1"
    local iso_file="/tmp/${VM_NAME}-cloud-init.iso"
    
    log_info "Creating cloud-init ISO: $iso_file"
    
    # Use genisoimage or mkisofs
    local iso_cmd="genisoimage"
    if ! command -v genisoimage >/dev/null 2>&1; then
        iso_cmd="mkisofs"
    fi
    
    if ! "$iso_cmd" -output "$iso_file" -volid cidata -joliet -rock "$temp_dir"/{user-data,meta-data,network-config} 2>/dev/null; then
        log_error "Failed to create cloud-init ISO"
        return 1
    fi
    
    echo "$iso_file"
}

create_virtual_machine() {
    local vm_disk="$1"
    local cloud_init_iso="$2"
    
    log_info "Creating virtual machine: $VM_NAME"
    
    # Use different disk specification based on whether we're using storage pools or paths
    local disk_spec
    if [[ -n "$STORAGE_PATH" && "$STORAGE_PATH" != "/var/lib/libvirt/images" ]]; then
        # Using explicit storage path
        disk_spec="path=$vm_disk,format=qcow2"
    else
        # Using storage pool - specify the volume directly
        local volume_name="${VM_NAME}.qcow2"
        disk_spec="vol=$STORAGE_POOL/$volume_name"
    fi
    
    local virt_install_args=(
        --name "$VM_NAME"
        --ram "$RAM_SIZE"
        --vcpus "$CPU_COUNT"
        --disk "$disk_spec"
        --disk "path=$cloud_init_iso,device=cdrom"
        --os-variant "debian$DEBIAN_VERSION"
        --network "network=$LIBVIRT_NETWORK"
        --graphics none
        --import
        --noautoconsole
    )
    
    # Add libvirt URI if specified
    if [[ -n "$LIBVIRT_URI" ]]; then
        virt_install_args+=(--connect "$LIBVIRT_URI")
    fi
    
    # Add console if requested
    if [[ "$CONSOLE_ACCESS" == true ]]; then
        virt_install_args+=(--console "pty,target_type=serial")
    fi
    
    if ! virt-install "${virt_install_args[@]}"; then
        log_error "Failed to create virtual machine"
        return 1
    fi
    
    log_success "Virtual machine '$VM_NAME' created successfully"
}

configure_vm_autostart() {
    if [[ "$AUTOSTART" == true ]]; then
        log_info "Enabling autostart for VM: $VM_NAME"
        local virsh_args
        virsh_args=$(get_virsh_args)
        
        if ! virsh $virsh_args autostart "$VM_NAME"; then
            log_warning "Failed to enable autostart"
        else
            log_success "Autostart enabled"
        fi
    fi
}

cleanup_temp_files() {
    local temp_dir="$1"
    local cloud_init_iso="$2"
    
    log_info "Cleaning up temporary files..."
    
    # Remove temporary directory
    [[ -d "$temp_dir" ]] && rm -rf "$temp_dir"
    
    # Remove cloud-init ISO (may need privileges)
    if [[ -f "$cloud_init_iso" ]]; then
        run_privileged rm -f "$cloud_init_iso" 2>/dev/null || true
    fi
}

# Main execution functions
parse_arguments() {
    # Check for help or check-only first
    for arg in "$@"; do
        case $arg in
            --help)
                usage
                exit 0
                ;;
            --check-only)
                CHECK_ONLY=true
                return 0
                ;;
        esac
    done
    
    if [[ $# -lt 3 ]]; then
        usage
        exit 1
    fi
    
    VM_NAME="$1"
    DISK_SIZE="$2"
    LIBVIRT_NETWORK="$3"
    shift 3
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --ram)
                RAM_SIZE="$2"
                shift 2
                ;;
            --cpus)
                CPU_COUNT="$2"
                shift 2
                ;;
            --user)
                USERNAME="$2"
                shift 2
                ;;
            --ssh-keys-github)
                SSH_KEYS_SOURCE="github"
                SSH_KEYS_GITHUB="$2"
                shift 2
                ;;
            --ssh-keys-gitlab)
                SSH_KEYS_SOURCE="gitlab"
                SSH_KEYS_GITLAB="$2"
                shift 2
                ;;
            --ssh-key-file)
                SSH_KEYS_SOURCE="file"
                SSH_KEY_FILE="$2"
                shift 2
                ;;
            --static-ip)
                STATIC_IP="$2"
                shift 2
                ;;
            --gateway)
                GATEWAY="$2"
                shift 2
                ;;
            --dns)
                DNS_SERVER="$2"
                shift 2
                ;;
            --storage-pool)
                STORAGE_POOL="$2"
                shift 2
                ;;
            --storage-path)
                STORAGE_PATH="$2"
                shift 2
                ;;
            --debian-version)
                DEBIAN_VERSION="$2"
                shift 2
                ;;
            --user-data)
                CUSTOM_USER_DATA="$2"
                shift 2
                ;;
            --libvirt-uri)
                LIBVIRT_URI="$2"
                shift 2
                ;;
            --autostart)
                AUTOSTART=true
                shift
                ;;
            --console)
                CONSOLE_ACCESS=true
                shift
                ;;
            --check-only)
                CHECK_ONLY=true
                shift
                ;;
            --help)
                usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done
}

validate_parameters() {
    log_info "Validating parameters..."
    
    validate_disk_size || exit 1
    validate_libvirt_network || exit 1
    validate_vm_name || exit 1
    validate_static_ip || exit 1
    
    # Validate storage (pool or path)
    if [[ -n "$STORAGE_PATH" ]]; then
        validate_storage_path || exit 1
    else
        validate_storage_pool || exit 1
    fi
    
    # Validate custom user-data file
    if [[ -n "$CUSTOM_USER_DATA" && ! -f "$CUSTOM_USER_DATA" ]]; then
        log_error "Custom user-data file not found: $CUSTOM_USER_DATA"
        exit 1
    fi
    
    log_success "All parameters validated"
}

main() {
    log_info "Starting KVM Debian VM creation script"
    
    # Parse command line arguments
    parse_arguments "$@"
    
    # Detect privilege requirements
    detect_privileges
    
    # Check prerequisites first
    if ! check_prerequisites; then
        exit 1
    fi
    
    # Exit if only checking prerequisites
    if [[ "$CHECK_ONLY" == true ]]; then
        log_success "Prerequisites check completed successfully"
        exit 0
    fi
    
    # Validate parameters
    validate_parameters
    
    # Get storage location (from pool or path)
    local storage_location
    if ! storage_location=$(get_storage_location); then
        exit 1
    fi
    
    # Update STORAGE_PATH for use in other functions
    STORAGE_PATH="$storage_location"
    
    # Get SSH keys
    local ssh_keys
    if ! ssh_keys=$(get_ssh_keys); then
        exit 1
    fi
    
    # Create temporary directory for cloud-init files
    local temp_dir
    temp_dir=$(mktemp -d)
    
    # Trap to cleanup on exit
    trap 'cleanup_temp_files "$temp_dir" "/tmp/${VM_NAME}-cloud-init.iso"' EXIT
    
    # Download Debian image
    local base_image
    if ! base_image=$(download_debian_image); then
        exit 1
    fi
    
    # Create cloud-init configuration
    create_cloud_init_files "$temp_dir" "$ssh_keys"
    
    # Create VM disk
    local vm_disk
    if ! vm_disk=$(create_vm_disk "$base_image"); then
        exit 1
    fi
    
    # Create cloud-init ISO
    local cloud_init_iso
    if ! cloud_init_iso=$(create_cloud_init_iso "$temp_dir"); then
        exit 1
    fi
    
    # Create virtual machine
    if ! create_virtual_machine "$vm_disk" "$cloud_init_iso"; then
        exit 1
    fi
    
    # Configure autostart if requested
    configure_vm_autostart
    
    # Display success information
    log_success "VM '$VM_NAME' created successfully!"
    echo
    echo "VM Details:"
    echo "  Name: $VM_NAME"
    echo "  RAM: ${RAM_SIZE}MB"
    echo "  CPUs: $CPU_COUNT"
    echo "  Disk: $DISK_SIZE"
    echo "  Network: $LIBVIRT_NETWORK"
    echo "  Username: $USERNAME"
    echo "  SSH Keys: $SSH_KEYS_SOURCE"
    [[ -n "$STATIC_IP" ]] && echo "  Static IP: $STATIC_IP"
    echo
    echo "Management commands:"
    echo "  Start VM:    virsh start $VM_NAME"
    echo "  Stop VM:     virsh shutdown $VM_NAME"
    echo "  Console:     virsh console $VM_NAME"
    echo "  Status:      virsh list --all"
    
    if [[ "$CONSOLE_ACCESS" == true ]]; then
        echo "  Serial console is enabled"
    fi
}

# Execute main function with all arguments
main "$@"
